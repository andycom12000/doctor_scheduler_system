{
  "name": "hospital-scheduler-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "npm run api:types",
    "dev": "vite",
    "predev:mock": "npm run api:types",
    "dev:mock": "vite --mode mock",
    "prebuild": "npm run api:types",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run api:types",
    "typecheck": "vue-tsc --build",
    "api:types": "openapi-typescript ../api-contract.yaml -o src/api/schema.d.ts",
    "mock:smoke": "tsx scripts/smoke-mock.ts",
    "api:smoke": "tsx scripts/smoke-mock.ts --target http://localhost:5080",
    "test": "vitest run",
    "pree2e": "npm run api:types && dotnet build ../src/Scheduler.Api/Scheduler.Api.csproj --configuration Release --nologo -v q",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
