# ---- .NET ----
bin/
obj/
*.user
*.suo
.vs/
artifacts/
publish/

# ---- Node ----
node_modules/
*.log
.npm/

# ---- 建置產物 ----
# 前端 build 產物。vite.config.ts 的 outDir 指向此處，由 npm run build 產生，
# 不進版控（emptyOutDir 每次建置都會清空）。
src/Scheduler.Shell/wwwroot/

# 由 api-contract.yaml 生成，見 npm run api:types
frontend/src/api/schema.d.ts

# ---- 隨附 runtime ----
# WebView2 Fixed Version 解開約 800MB，由 build/fetch-webview2.ps1 解壓，不進版控。
build/webview2-runtime/
# 手動下載的 Fixed Version .cab（~350MB），同樣不進版控
build/*.cab

# ---- portable 執行期資料 ----
# 所有狀態都寫在程式旁的 data/，見 docs/ARCHITECTURE.md §3.2
data/

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# SQLite 側檔（WAL 模式）。data/ 本身已排除，這裡守開發期放在別處的資料庫
*.db
*.db-wal
*.db-shm

# ---- 真實名冊檔（#82）----
# 含真實姓名與員編，絕不進版控；一律放 repo 外，用 build/publish.ps1 -RosterFile 帶入
roster.csv
*roster*.csv
*名冊*.csv
/roster/
