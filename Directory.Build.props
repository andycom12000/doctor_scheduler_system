<Project>

  <!-- 全 solution 共用設定。個別專案僅覆寫確有必要者。 -->
  <!--
    版本號的唯一來源（SemVer）。.NET 組件與 HospitalScheduler.exe 的檔案／產品版本、
    build/publish.ps1 的輸出資料夾名、前端畫面（frontend/vite.config.ts 建置時讀這裡）都從這個值來。
    不要在任何 csproj 覆寫 Version（publish.ps1 會比對 exe 的 ProductVersion，不符就失敗）。
    發佈流程見 docs/release-process.md。
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <!-- 產品版本只留 1.0.0，不要 SDK 預設附加的 +<commit hash> -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    發佈形態：資料夾式 portable。詳見 docs/ARCHITECTURE.md §6。

    RuntimeIdentifier / SelfContained 寫在 Scheduler.Shell.csproj 本身，不在這裡：
    Directory.Build.props 在專案檔本體之前匯入，此時專案裡宣告的屬性（例如舊版的
    IsPublishable）尚不存在，條件永遠為假 —— 結果是 publish 出 framework-dependent
    的產物，在沒裝 .NET 的機器上直接起不來。這個坑已經踩過一次。
  -->
  <PropertyGroup>
    <!-- 自解壓到 %TEMP% 會觸發 AppLocker / EDR 攔截，且冷啟動變慢 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- OR-Tools 的 P/Invoke wrapper 不保證與 trim / AOT 相容 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

</Project>
