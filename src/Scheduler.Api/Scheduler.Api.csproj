<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Scheduler.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestServer：正式版 Shell 與契約守法測試都用它在 process 內跑同一個 pipeline（§6.2） -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- ClosedXML 宣告的是 [1.0.0, 3.0.0)；1.0.0 是 Apache-2.0，2.x 起是 Six Labors Split License，釘在下界（ARCHITECTURE §6.4） -->
    <PackageReference Include="SixLabors.Fonts" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scheduler.Application\Scheduler.Application.csproj" />
    <ProjectReference Include="..\Scheduler.Solver\Scheduler.Solver.csproj" />
    <ProjectReference Include="..\Scheduler.Persistence\Scheduler.Persistence.csproj" />
  </ItemGroup>

  <!--
    開發期 transport。與 Scheduler.Shell 共用同一組 handler（硬性規則 #2）：
    本專案不得實作任何業務邏輯，只負責 HTTP ←→ Application 的轉換。
  -->

</Project>
