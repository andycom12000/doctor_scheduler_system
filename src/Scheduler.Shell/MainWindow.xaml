<Window x:Class="Scheduler.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="醫院排班系統" Height="800" Width="1280" MinWidth="700" MinHeight="420"
        WindowStartupLocation="Manual"
        SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" Closed="OnClosed">

    <!--
        正式版殼：單一 WebView2 控制項填滿視窗。環境初始化、WebResourceRequested 攔截
        （/api 轉 Api、靜態檔讀 wwwroot）與 SPA deep link fallback 的規格見 docs/ARCHITECTURE.md §6，
        全部在 MainWindow.xaml.cs 的 OnLoaded。
    -->
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
    </Grid>
</Window>
