<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- 契約守法：回應 JSON 用 api-contract.yaml 的 schema 驗（ARCHITECTURE §7） -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scheduler.Api\Scheduler.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 測試讀的是 repo 根目錄那一份契約，不另抄一份 -->
    <None Include="..\..\api-contract.yaml" Link="api-contract.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
